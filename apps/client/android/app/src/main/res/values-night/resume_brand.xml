<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="resume_launch_background">#101016</color>

    <style name="ResumeLaunchBaseTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/resume_launch_background</item>
        <item name="android:statusBarColor">@color/resume_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ResumeNormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/resume_launch_background</item>
        <item name="android:statusBarColor">@color/resume_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
