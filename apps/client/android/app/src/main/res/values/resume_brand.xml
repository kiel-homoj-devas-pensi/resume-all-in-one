<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">简历全能帮</string>
    <color name="resume_icon_background">#E0EBFF</color>
    <color name="resume_launch_background">#F8FAFF</color>

    <style name="ResumeLaunchBaseTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/resume_launch_background</item>
        <item name="android:statusBarColor">@color/resume_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="ResumeLaunchTheme" parent="ResumeLaunchBaseTheme" />

    <style name="ResumeNormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/resume_launch_background</item>
        <item name="android:statusBarColor">@color/resume_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
