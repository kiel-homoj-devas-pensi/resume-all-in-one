# 本文件只列占位符，不由服务自动读取。真实配置从仓库外或进程安全注入。
GATEWAY_DATABASE_BACKEND=sqlite
AGENT_GATEWAY_TASK018_DATABASE_PATH=<outside-repository-synthetic-sqlite-path>

# MySQL 业务启动只核对已有结构；PNVS 要求完整 v4。
# 切换时移除 AGENT_GATEWAY_TASK018_DATABASE_PATH，显式选择 mysql。
# GATEWAY_DATABASE_DSN=mysql://<business-user>:<encoded-password>@<tls-host>:3306/resume_gateway_synthetic_test
# GATEWAY_DATABASE_TLS_CA_FILE=<outside-repository-ca-file>
# GATEWAY_DATABASE_EXPIRES_AT_UTC=<actual-returned-expiresAt-in-UTC>
# GATEWAY_DATABASE_MIGRATION_DSN=mysql://<different-migration-user>:<encoded-password>@<same-host>:3306/resume_gateway_synthetic_test

# PNVS 必须成对配置，文件位于仓库外并绑定同一 Windows 用户。
# 不放 AccessKey/OTP/audit 明文；配置存在不代表预算已经批准。
# AGENT_GATEWAY_PNVS_CREDENTIALS_PATH=<outside-repository-credentials.dpapi>
# AGENT_GATEWAY_PNVS_RUNTIME_PATH=<outside-repository-runtime.dpapi>
# 生产同时需要既有真实 GLM 配置；不允许 Fake 身份、短信、Provider 或开发 token。
# AGENT_GATEWAY_EXECUTION_ENVIRONMENT=production
# AGENT_GATEWAY_REMOTE_PROVIDER_MODE=glm

# 显式合成开发云同步：已有 SQLite v6 / MySQL v5，只读核验、不在启动时迁移。
# 准备工具逐项要求政策并生成独立游标秘密；无配置时云能力关闭。
# AGENT_GATEWAY_ENABLE_TASK018_FAKE_IDENTITY=true
# AGENT_GATEWAY_CLOUD_RUNTIME_PATH=<outside-repository-cloud-runtime.dpapi>
# 也可保留已批准预算的同库 PNVS 配置，但不能同时启用 Fake 身份。
# 云运行配置禁止与账户/生命周期/CloudStore注入混用；生产仍拒绝。

# 账号角色/永久会员：默认关闭。开启只核验显式迁移后的 SQLite v7 / MySQL v6。
# 新版本包含既有云表结构，但本开关不会开放云同步或自动授予权限。
# AGENT_GATEWAY_ENABLE_ACCOUNT_PRIVILEGES=true
# 以下仅注入离线管理命令的进程；不要提交真实号码，不在 Web 服务中保留。
# AGENT_GATEWAY_PRIVILEGE_TARGET_PHONE=<verified-owner-E164-in-restricted-configuration>
