{
  "components": {
    "schemas": {
      "AgentResponsePayload": {
        "additionalProperties": false,
        "properties": {
          "citations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Citations",
            "type": "array"
          },
          "nextAction": {
            "const": "none",
            "default": "none",
            "title": "Nextaction",
            "type": "string"
          },
          "proposedPatch": {
            "title": "Proposedpatch",
            "type": "null"
          },
          "summary": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "warnings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "summary"
        ],
        "title": "AgentResponsePayload",
        "type": "object"
      },
      "GatewayAgentRequest": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "const": "gatewayContractProbe",
            "title": "Capability",
            "type": "string"
          },
          "clientRequestId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Clientrequestid",
            "type": "string"
          },
          "protocolVersion": {
            "const": "0.1.0",
            "title": "Protocolversion",
            "type": "string"
          },
          "syntheticInput": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Syntheticinput",
            "type": "string"
          }
        },
        "required": [
          "protocolVersion",
          "clientRequestId",
          "capability",
          "syntheticInput"
        ],
        "title": "GatewayAgentRequest",
        "type": "object"
      },
      "GatewayAgentSuccessResponse": {
        "additionalProperties": false,
        "properties": {
          "agentResponse": {
            "$ref": "#/components/schemas/AgentResponsePayload"
          },
          "clientRequestId": {
            "title": "Clientrequestid",
            "type": "string"
          },
          "execution": {
            "$ref": "#/components/schemas/GatewayExecutionMetadata"
          },
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "protocolVersion": {
            "const": "0.1.0",
            "default": "0.1.0",
            "title": "Protocolversion",
            "type": "string"
          },
          "status": {
            "const": "succeeded",
            "default": "succeeded",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "clientRequestId",
          "agentResponse"
        ],
        "title": "GatewayAgentSuccessResponse",
        "type": "object"
      },
      "GatewayError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "issues": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/GatewayErrorIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issues"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "operationId",
          "retryable"
        ],
        "title": "GatewayError",
        "type": "object"
      },
      "GatewayErrorIssue": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "code"
        ],
        "title": "GatewayErrorIssue",
        "type": "object"
      },
      "GatewayErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/GatewayError"
          }
        },
        "required": [
          "error"
        ],
        "title": "GatewayErrorResponse",
        "type": "object"
      },
      "GatewayExecutionMetadata": {
        "additionalProperties": false,
        "properties": {
          "providerMode": {
            "const": "mock",
            "default": "mock",
            "title": "Providermode",
            "type": "string"
          },
          "usesNetwork": {
            "const": false,
            "default": false,
            "title": "Usesnetwork",
            "type": "boolean"
          }
        },
        "title": "GatewayExecutionMetadata",
        "type": "object"
      },
      "GatewayHealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "alive",
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "GatewayHealthResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "DevelopmentBearer": {
        "description": "Task 017 本机开发期 Bearer token；不是生产鉴权。",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Task 017 Mock-only Gateway contract. No real resume data or remote Provider.",
    "title": "Resume All-in-One Agent Gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "readLiveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readliveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readReadiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayHealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readreadiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/agent/requests": {
      "post": {
        "operationId": "submitAgentRequest_v1_agent_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GatewayAgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayAgentSuccessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "summary": "Submitagentrequest",
        "tags": [
          "agent"
        ]
      }
    }
  }
}
