    {
      "name": "resume_documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"resume_documents\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"current_version_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"metadata_json\" TEXT NOT NULL, \"extensions_json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "resume_versions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"resume_versions\" (\"id\" TEXT NOT NULL, \"document_id\" TEXT NOT NULL REFERENCES resume_documents (id) ON DELETE CASCADE, \"parent_version_id\" TEXT NULL, \"schema_version\" TEXT NOT NULL, \"content_json\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"extensions_json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"setting_key\" TEXT NOT NULL, \"bool_value\" INTEGER NOT NULL CHECK (\"bool_value\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"setting_key\"));"
        }
      ]
    },
