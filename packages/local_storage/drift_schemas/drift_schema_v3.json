  "fixed_sql": [
    {
      "name": "resume_documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"resume_documents\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"current_version_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"metadata_json\" TEXT NOT NULL, \"extensions_json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "resume_versions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"resume_versions\" (\"id\" TEXT NOT NULL, \"document_id\" TEXT NOT NULL REFERENCES resume_documents (id) ON DELETE CASCADE, \"parent_version_id\" TEXT NULL, \"schema_version\" TEXT NOT NULL, \"content_json\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"extensions_json\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"setting_key\" TEXT NOT NULL, \"bool_value\" INTEGER NOT NULL CHECK (\"bool_value\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"setting_key\"));"
        }
      ]
    },
    {
      "name": "agent_runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"agent_runs\" (\"id\" TEXT NOT NULL, \"request_id\" TEXT NOT NULL UNIQUE, \"document_id\" TEXT NOT NULL, \"resume_version_id\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"route_status\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"finished_at\" INTEGER NOT NULL, \"tool_call_count\" INTEGER NOT NULL DEFAULT 0, \"error_code\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tool_calls",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tool_calls\" (\"id\" TEXT NOT NULL, \"agent_run_id\" TEXT NOT NULL REFERENCES agent_runs (id) ON DELETE CASCADE, \"tool_name\" TEXT NOT NULL, \"tool_version\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"finished_at\" INTEGER NOT NULL, \"offline\" INTEGER NOT NULL CHECK (\"offline\" IN (0, 1)), \"replayed\" INTEGER NOT NULL CHECK (\"replayed\" IN (0, 1)), \"error_code\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
